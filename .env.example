# ============================================
# OptiWallet Environment Variables
# ============================================
# Bu dosyayı .env olarak kopyala ve gerçek değerleri gir
# .env dosyası git'e push edilmez (.gitignore'da)
# ============================================

# ===== Application =====
APP_NAME=OptiWallet
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ===== Gemini AI =====
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp

# ===== Database (PostgreSQL) =====
POSTGRES_USER=optiwallet
POSTGRES_PASSWORD=optiwallet_dev_2026
POSTGRES_DB=optiwallet
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://optiwallet:optiwallet_dev_2026@postgres:5432/optiwallet

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ===== Security =====
JWT_SECRET_KEY=change-this-to-a-very-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ROUNDS=12
ENCRYPTION_KEY=change-this-to-32-byte-base64-key

# ===== OAuth =====
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=

# ===== Email (Resend) =====
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@optiwallet.app
EMAIL_FROM_NAME=OptiWallet

# ===== pgAdmin (Development Tool) =====
PGADMIN_EMAIL=admin@optiwallet.app
PGADMIN_PASSWORD=change-this-to-strong-password

# ===== Storage (MinIO/S3) =====
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=optiwallet
S3_SECRET_KEY=optiwallet_dev_2026
S3_BUCKET=optiwallet-uploads
S3_REGION=us-east-1

# ===== Mock Bank API =====
MOCK_BANK_API_URL=http://mock-bank-api:8001
MOCK_BANK_CLIENT_ID=optiwallet
MOCK_BANK_CLIENT_SECRET=optiwallet_mock_secret_2026

# ===== Sentry (Error Tracking) =====
SENTRY_DSN=

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-very-long-random-string

# ===== Rate Limiting =====
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FORMAT=json